# Copy this file to `.env` and fill in values from your own Supabase
# project (Project Settings > API) to build/run Black Server Book against
# your own backend. `.env` itself is gitignored — never commit real keys.
#
# Only ANON_KEY and SUPABASE_PUBLIC_URL are actually read by this repo's
# build (see build.rs, which bakes them into the compiled app at build
# time via `env!()`). The rest are here because a full self-hosted setup
# (a Supabase project, its Edge Functions, and/or a self-hosted Supabase
# Docker stack) needs them somewhere — see each comment below for exactly
# where.

# --- Used directly by this app's build (build.rs) ---

# Your Supabase project's REST/Auth base URL (Project Settings > API).
# Falls back to http://localhost:8000 if unset, which only makes sense if
# you're running a local self-hosted Supabase stack on the default port.
SUPABASE_PUBLIC_URL=https://your-project-ref.supabase.co

# The anon/public API key (Project Settings > API > Project API keys).
# Safe to ship to the client — Supabase's row-level security policies
# (see scripts/2026-07-22-rls-and-self-entity.sql) are what actually keep
# one account's data from another's, not secrecy of this key.
ANON_KEY=your-anon-key-here

# --- Not read by this app's build, but needed elsewhere in a full setup ---

# Full admin access, bypasses row-level security entirely — never expose
# this to a client. Needed by the delete-account Edge Function
# (supabase/functions/delete-account/index.ts), configured as a secret in
# your Supabase project (`supabase secrets set`), not read from this file
# by the Rust app itself.
SERVICE_ROLE_KEY=your-service-role-key-here

# Supabase's newer rotating-key scheme (replaces the legacy anon/service-
# role keys above on newer projects) — same purposes as ANON_KEY/
# SERVICE_ROLE_KEY respectively, if your project has these instead.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here
SUPABASE_SECRET_KEY=sb_secret_your-key-here

# Only relevant if you're running a self-hosted Supabase stack (GoTrue/
# Postgres/PostgREST via Docker) rather than Supabase's hosted platform —
# these configure that stack's own JWT verification and signing, not
# anything this app's build reads directly.
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
# The actual signing keys for a self-hosted GoTrue instance — as sensitive
# as SERVICE_ROLE_KEY (contains real private key material once filled in).
# Generate your own; never reuse an example/sample value for anything real.
JWT_JWKS=[]

# --- Optional ---

# Cloudflare Turnstile site key for signup/login bot protection (see
# views/auth.rs). Leave empty (the default) to skip rendering the widget
# entirely — this is a real no-op until you actually configure Turnstile
# protection in your Supabase project's Auth settings.
TURNSTILE_SITE_KEY=
